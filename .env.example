# Configurações do AdsPower Local API
ADSPOWER_URL=http://127.0.0.1:50325
ADSPOWER_API_KEY=

# Defina como "true" para usar AdsPower ou "false" para usar Chromium Playwright local (ideal para dev/CI)
USE_ADSPOWER=false

# URL da aplicação de homologação a ser testada
ONBOARDING_URL=http://localhost:3000/register

# Configurações de Concorrência e Execução de QA
MAX_CONCURRENCY=2
DEFAULT_TIMEOUT=10000
MAX_RETRIES=2
RATE_LIMIT_DELAY=1.0

# Configurações do Navegador Local (quando USE_ADSPOWER=false)
HEADLESS=true

# Caminhos de Arquivos e Dados
CSV_PATH=data/usuarios.csv
LOG_DIR=logs
REPORT_DIR=reports

