# Configurações do AdsPower Local API
ADSPOWER_URL=http://127.0.0.1:50325
ADSPOWER_API_KEY=

# Defina como "true" para usar AdsPower ou "false" para usar Chromium Playwright local (ideal para dev/CI)
USE_ADSPOWER=true

# URL da aplicação de homologação a ser testada (Lovable Signup)
ONBOARDING_URL=https://lovable.dev/signup

# Configurações de Concorrência e Execução de QA
MAX_CONCURRENCY=2
DEFAULT_TIMEOUT=15000
MAX_RETRIES=2
RATE_LIMIT_DELAY=1.0

# Configurações do Navegador Local (quando USE_ADSPOWER=false)
HEADLESS=true

# Caminhos de Arquivos e Dados
CSV_PATH=data/usuarios.csv
LOG_DIR=logs
REPORT_DIR=reports

# ==========================================
# COLE O SEU LINK DO DISCORD AQUI EMBAIXO:
# ==========================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1572780922586144801/FYgYdd0_G1pfnddYJoUHNwr0ytvPRfybfcvffymXdZxyTKJuMWT8KB-G0u7ojQOFczDU

# ==========================================
# VERIFICAÇÃO AUTOMÁTICA DE E-MAIL (CATCH-ALL)
# Ative para abrir automaticamente o link de ativação enviado para o e-mail
# ==========================================
VERIFY_EMAIL=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_WAIT_TIMEOUT=60
EMAIL_POLL_INTERVAL=3.0
